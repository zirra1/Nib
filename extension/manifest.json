{
  "manifest_version": 3,
  "name": "Nib: your cursor everywhere",
  "short_name": "Nib",
  "version": "1.0.0",
  "description": "Wear the cursor you made in Nib on every website. It only changes your cursor. It doesn't read pages or send anything anywhere.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Nib",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
